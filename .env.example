AI_PROVIDER=codex
# Blank model uses your Codex CLI default; select an image-capable model.
CODEX_MODEL=
CODEX_CLI_PATH=
CODEX_TIMEOUT_SECONDS=600
ANTIGRAVITY_MODEL=claude-opus-4-6-thinking
# Per CLI call; 30–1800 seconds. Browser wait follows this setting.
ANTIGRAVITY_TIMEOUT_SECONDS=600
# Optional absolute path; otherwise use the official CLI default install location.
ANTIGRAVITY_CLI_PATH=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_MAX_TOKENS=8192
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
PORT=3001
